# APP
NODE_ENV=development
PORT=4000

# DATABASE — conecta al postgres levantado con Docker (puerto 5433 en el host)
DATABASE_URL="postgresql://clave_segura:clave_segura@localhost:5433/clave_segura?schema=public"
DIRECT_URL="postgresql://clave_segura:clave_segura@localhost:5433/clave_segura"

# Docker
DB_USER=clave_segura
DB_PASSWORD=clave_segura
DB_NAME=clave_segura

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro
JWT_EXPIRES_IN="12h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS — lista separada por comas de origins permitidos
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# DOCS
URL_DOCS=http://localhost:4000/docs

# BCRYPT
BCRYPT_SALT_ROUNDS=12

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# LOGS
LOG_LEVEL=debug
PRISMA_LOG_QUERIES=true
